# ============================================================
# Atlas Enterprise AI Platform — Production Environment Configuration
# ============================================================

# App Configuration
APP_NAME=Atlas Enterprise Decision Intelligence
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=atlas-enterprise-super-secret-key-production-change-me

# Ollama LLM & Embedding Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
EMBEDDING_DIMENSION=768

# PostgreSQL & pgvector Database Settings
DATABASE_URL=postgresql+asyncpg://atlas_user:atlas_secure_password@localhost:5432/atlas_db
# For SQLite fallback during local development without postgres container:
# DATABASE_URL=sqlite+aiosqlite:///./atlas_local.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Hybrid Search & Reranking Parameters
TOP_K_RETRIEVAL=15
TOP_K_RERANK=5
RRF_K_CONSTANT=60
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
RERANKER_TYPE=cross_encoder
RERANK_MIN_SCORE=0.35

# LangGraph Decision Intelligence Parameters
MAX_REWRITE_CYCLES=2
HALLUCINATION_GUARD_THRESHOLD=0.75
DECISION_CONFIDENCE_THRESHOLD=0.70

# RAGAS Evaluation Parameters
RAGAS_EVAL_ENABLED=true
RAGAS_SAMPLE_RATE=0.20
